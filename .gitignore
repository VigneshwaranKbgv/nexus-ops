# Java / Maven
target/
*.class
*.jar
*.war
*.ear
.mvn/wrapper/maven-wrapper.properties
# Note: Keep the maven-wrapper.jar if you want zero-install wrapper downloads, but standard gitignore keeps properties and ignores jar. Let's keep jar since it's already there and useful.
# We'll just ignore typical IDE and build outputs:
.project
.classpath
.factorypath
.settings/
*.iml
.idea/
.vscode/

